<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ankama Profile Scraper Client</title>
    <!-- Estilos rápidos y modernos usando un CDN de CSS -->
    <link rel="stylesheet" href="https://jsdelivr.net">
    <style>
        .container { max-width: 900px; margin-top: 2rem; }
        .hidden { display: none; }
        .error-box { background-color: #ffdddd; color: #900; padding: 1rem; border-radius: 4px; margin-bottom: 1rem; }
        .loader { border: 4px solid #f3f3f3; border-top: 4px solid #3498db; border-radius: 50%; width: 30px; height: 30px; animation: spin 1s linear infinite; margin: 1rem auto; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <main class="container">
        <h2>Consultar Perfil de Ankama</h2>
        
        <!-- Formulario de Configuración y Búsqueda -->
        <form id="apiForm" onsubmit="fetchProfile(event)">
            <label for="apiUrl">
                1. URL Base de tu API de Ngrok:
                <input type="url" id="apiUrl" placeholder="https://ngrok-free.app" required>
            </label>
            
            <label for="profileName">
                2. Nombre del Perfil de Ankama:
                <input type="text" id="profileName" placeholder="tien-2358" required>
            </label>
            
            <button type="submit" id="btnSubmit">Buscar Personajes</button>
        </form>

        <!-- Indicador de Carga -->
        <div id="loader" class="loader hidden"></div>

        <!-- Caja de Errores -->
        <div id="errorBox" class="error-box hidden"></div>

        <!-- Tabla de Resultados -->
        <section id="resultsSection" class="hidden">
            <h3>Personajes de <span id="displayProfile"></span></h3>
            <figure>
                <table>
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Clase</th>
                            <th>Nivel</th>
                            <th>Servidor</th>
                            <th>Gremio</th>
                        </tr>
                    </thead>
                    <tbody id="charactersTableBody">
                        <!-- Las filas se insertarán dinámicamente aquí -->
                    </tbody>
                </table>
            </figure>
        </section>
    </main>

    <script>
        async function fetchProfile(event) {
            event.preventDefault();
            
            // Captura de elementos del DOM
            const apiUrlInput = document.getElementById('apiUrl').value.trim();
            const profileName = document.getElementById('profileName').value.trim();
            const loader = document.getElementById('loader');
            const errorBox = document.getElementById('errorBox');
            const resultsSection = document.getElementById('resultsSection');
            const tableBody = document.getElementById('charactersTableBody');
            const displayProfile = document.getElementById('displayProfile');
            const btnSubmit = document.getElementById('btnSubmit');

            // Limpieza de estados anteriores
            errorBox.classList.add('hidden');
            resultsSection.classList.add('hidden');
            tableBody.innerHTML = '';
            
            // Activar loader y deshabilitar botón
            loader.classList.remove('hidden');
            btnSubmit.disabled = true;

            // Asegurar que la URL base no termine en barra diagonal '/'
            const cleanApiUrl = apiUrlInput.endsWith('/') ? apiUrlInput.slice(0, -1) : apiUrlUrlInput;

            try {
                // Llamada a la API construyendo la ruta completa
                const response = await fetch(`${cleanApiUrl}/profile/${profileName}`);
                
                if (!response.ok) {
                    const errData = await response.json();
                    throw new Error(errData.detail || `Error en el servidor: ${response.status}`);
                }

                const data = await response.json();

                if (!data.characters || data.characters.length === 0) {
                    throw new Error("El perfil no contiene personajes visibles.");
                }

                // Renderizar datos en la tabla
                displayProfile.textContent = data.profile;
                data.characters.forEach(char => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td><strong>${char.name}</strong></td>
                        <td>${char.class}</td>
                        <td>${char.level}</td>
                        <td>${char.server}</td>
                        <td>${char.guild}</td>
                    `;
                    tableBody.appendChild(row);
                });

                // Mostrar la sección de resultados
                resultsSection.classList.remove('hidden');

            } catch (error) {
                // Manejo y despliegue de errores
                errorBox.textContent = `Error: ${error.message}`;
                errorBox.classList.remove('hidden');
            } finally {
                // Desactivar loader y rehabilitar botón
                loader.classList.add('hidden');
                btnSubmit.disabled = false;
            }
        }
    </script>
</body>
</html>
